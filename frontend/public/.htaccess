# Apache SPA + API coexistence for public_html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep existing files/folders as-is (assets, api/, uploads, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite API requests to the React app
  RewriteRule ^api(/|$) - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

# Optional hardening
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Disable directory listing
Options -Indexes
